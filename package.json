{
  "name": "morosystems-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript automation tests for the MoroSystems QA assignment.",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --grep-invert \"@manual-captcha|@visual\"",
    "test:list": "playwright test --list",
    "test:api": "playwright test --project=api",
    "test:gui": "playwright test --project=chromium --project=firefox --project=webkit --grep-invert \"@manual-captcha|@visual\"",
    "test:gui:chromium": "playwright test --project=chromium --grep-invert \"@manual-captcha|@visual\"",
    "test:gui:firefox": "playwright test --project=firefox --grep-invert \"@manual-captcha|@visual\"",
    "test:gui:webkit": "playwright test --project=webkit --grep-invert \"@manual-captcha|@visual\"",
    "test:google:manual": "playwright test tests/gui/google-to-career.spec.ts --project=chromium --debug --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
