
# ==========================================
# MOROSYSTEMS PLAYWRIGHT TEST FRAMEWORK
# ==========================================

# Node.js dependencies
node_modules/

# Playwright test results and reports
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# TypeScript build outputs
/dist/
/build/
*.tsbuildinfo

# IDE settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Locally cloned MoroSystems backend
/todo-be/

# Locally generated API documentation
/openapi.json
